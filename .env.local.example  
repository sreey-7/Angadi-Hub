# .env.local.example
# ─────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp .env.local.example .env.local
#   2. Fill in your real values below
#   3. NEVER commit .env.local to git (it's in .gitignore by default)
# ─────────────────────────────────────────────────────────────────


# ── Phase 2: MongoDB ─────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com
# Create a free M0 cluster → Connect → Drivers → copy the URI
# Replace <user>, <password>, and <cluster> with your values

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/angadi-hub?retryWrites=true&w=majority


# ── Phase 4: Razorpay (Test Mode) ───────────────────────────────
# Get these from: https://dashboard.razorpay.com
# Left sidebar → Settings → API Keys → Generate Test Key
#
# RAZORPAY_KEY_SECRET must NEVER be exposed to the browser.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose (used in client checkout).

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx


# ── Phase 5 (optional): Image hosting ───────────────────────────
# If you upload product images to Cloudinary, add your cloud name here.
# Then add the hostname to next.config.ts → images.remotePatterns

# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name